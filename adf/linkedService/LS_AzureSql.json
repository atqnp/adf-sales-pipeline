{
  "name": "LS_AzureSql",
  "properties": {
    "description": "Azure SQL Database. The password is a Key Vault reference, so no secret lives in the factory or in Git.",
    "type": "AzureSqlDatabase",
    "typeProperties": {
      "server": "sql-adf-lab-214a8.database.windows.net",
      "database": "sqldb-sales",
      "encrypt": "mandatory",
      "trustServerCertificate": false,
      "authenticationType": "SQL",
      "userName": "sqladminuser",
      "password": {
        "type": "AzureKeyVaultSecret",
        "store": { "referenceName": "LS_KeyVault", "type": "LinkedServiceReference" },
        "secretName": "sql-admin-password"
      }
    }
  }
}
