{
  "name": "DS_ADLS_Csv",
  "properties": {
    "description": "Any CSV file in the raw container.",
    "linkedServiceName": { "referenceName": "LS_ADLS", "type": "LinkedServiceReference" },
    "parameters": {
      "folder": { "type": "string", "defaultValue": "landing" },
      "fileName": { "type": "string" }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "raw",
        "folderPath": { "value": "@dataset().folder", "type": "Expression" },
        "fileName": { "value": "@dataset().fileName", "type": "Expression" }
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "quoteChar": "\"",
      "firstRowAsHeader": true
    },
    "schema": []
  }
}
