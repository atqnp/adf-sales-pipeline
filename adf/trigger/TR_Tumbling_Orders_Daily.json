{
  "name": "TR_Tumbling_Orders_Daily",
  "properties": {
    "description": "24-hour tumbling windows over src.orders. startTime in the past means starting the trigger backfills every window up to endTime (19-25 Oct 2026, 7 windows), at most 2 at a time.",
    "type": "TumblingWindowTrigger",
    "typeProperties": {
      "frequency": "Hour",
      "interval": 24,
      "startTime": "2026-10-19T00:00:00Z",
      "endTime": "2026-10-26T00:00:00Z",
      "delay": "00:00:00",
      "maxConcurrency": 2,
      "retryPolicy": { "count": 2, "intervalInSeconds": 30 },
      "dependsOn": []
    },
    "pipeline": {
      "pipelineReference": { "referenceName": "PL_Load_Orders_Window", "type": "PipelineReference" },
      "parameters": {
        "p_window_start": "@trigger().outputs.windowStartTime",
        "p_window_end": "@trigger().outputs.windowEndTime"
      }
    }
  }
}
